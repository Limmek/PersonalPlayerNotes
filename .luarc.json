{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime": {
        "version": "Lua 5.1",
        "builtin": {
            "basic": "disable",
            "debug": "disable",
            "io": "disable",
            "math": "disable",
            "os": "disable",
            "package": "disable",
            "string": "disable",
            "table": "disable",
            "utf8": "disable"
        }
    },
    "completion": {
        "callSnippet": "Both"
    },
    "diagnostics": {
        "enable": true,
        "disable": [
            "undefined-field",
            "unused-local",
            "missing-fields",
            "inject-field",
            "need-check-nil",
            "duplicate-set-field",
            "param-type-mismatch",
            "redundant-parameter",
            "lowercase-global",
            "assign-type-mismatch",
            "invisible"
        ],
        "globals": [
            "Menu",
            "StaticPopupDialogs",
            "StaticPopup_Show",
            "UIDROPDOWNMENU_MENU_LEVEL",
            "UIDropDownMenu_AddButton",
            "TooltipDataProcessor",
            "Settings",
            "UIDropDownMenu_CreateInfo",
            "SettingsPanel",
            "GameMenuFrame",
            "UIDROPDOWNMENU_MENU_VALUE",
            "ShitlistDB",
            "ReloadUI",
            "LoadAddOn",
            "DisableAddOn",
            "UnitPopup_ShowMenu",
            "os",
            "io",
            "package",
            "debug",
            "loadfile",
            "dofile",
            "files",
            "CLOSE",
            "GameFontHighlight",
            "GetNumMacroIcons",
            "GetMacroIconInfo",
            "GetMacroIcons",
            "GetMacroItemIcons",
            "GetLooseMacroIcons",
            "GetLooseMacroItemIcons",
            "PersonalPlayerNotes",
            "time",
            "tinsert",
            "tremove",
            "WOW_PROJECT_ID",
            "WOW_PROJECT_MAINLINE",
            "C_AddOns",
            "C_UI",
            "LibStub",
            "Enum",
            "GameTooltip",
            "UnitIsPlayer",
            "UnitName",
            "UnitFullName",
            "GetRealmName",
            "issecretvalue",
            "HideUIPanel",
            "IsShiftKeyDown",
            "IsControlKeyDown",
            "PlaySoundFile",
            "CreateFrame",
            "UIParent"
        ]
    }
}
